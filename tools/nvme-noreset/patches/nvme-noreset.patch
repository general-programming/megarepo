 static void nvme_handle_aer_persistent_error(struct nvme_ctrl *ctrl)
 {
+	/*
+	 * nvme-noreset: for allow-listed devices, log and do nothing. The
+	 * caller returns without requeueing async_event_work, so no new AER
+	 * is outstanding and the controller cannot post another AEN -- the
+	 * reset loop stops and admin commands get an unlimited window.
+	 */
+	if (nvme_noreset_suppress_reset(ctrl->dev)) {
+		dev_warn_ratelimited(ctrl->device,
+			"nvme-noreset: persistent internal error, reset suppressed\n");
+		return;
+	}
+
 	dev_warn(ctrl->device,
 		"resetting controller due to persistent internal error\n");
